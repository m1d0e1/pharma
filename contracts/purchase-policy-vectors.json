  "allocation": [
    {
      "name": "tax expenses discounts and bonus allocate consistently",
      "items": [
        {
          "id": 1,
          "quantity": 2,
          "cost_price": 10,
          "selling_price": 15,
          "bonus_quantity": 1,
          "tax_percent": 10,
          "discount_percent": 0,
          "strips_per_box": 1,
          "expiry_date": "2028-01-31"
        }
      ],
      "header": {
        "tax_percent": 5,
        "expenses": 3,
        "discount_value": 1,
        "discount_percent": 10
      },
      "expected_total": 22.59,
      "expected_unit_costs": [7.53]
    },
    {
      "name": "multiple lines retain per-line allocated cost",
      "items": [
        {
          "id": 1,
          "quantity": 1,
          "cost_price": 5,
          "selling_price": 8,
          "bonus_quantity": 0,
          "tax_percent": 0,
          "discount_percent": 0,
          "strips_per_box": 1,
          "expiry_date": "2028-01-31"
        },
        {
          "id": 2,
          "quantity": 2,
          "cost_price": 8,
          "selling_price": 12,
          "bonus_quantity": 1,
          "tax_percent": 5,
          "discount_percent": 0,
          "strips_per_box": 1,
          "expiry_date": "2028-02-29"
        }
      ],
      "header": {
        "tax_percent": 0,
        "expenses": 0,
        "discount_value": 0,
        "discount_percent": 0
      },
      "expected_total": 21.8,
      "expected_unit_costs": [5.0, 5.6]
    }
  ],
  "accounting": [
    {
      "name": "credit purchase posts payable and supplier liability",
      "payment_method": "credit",
      "total_amount": 100,
      "expected": {
        "settlement_account": "payable",
        "supplier_balance_delta": 100,
        "supplier_transactions": [
          { "type": "invoice", "amount": 100 }
        ],
        "cash_movement": null
      }
    },
    {
      "name": "check purchase posts payable and supplier liability",
      "payment_method": "check",
      "total_amount": 100,
      "expected": {
        "settlement_account": "payable",
        "supplier_balance_delta": 100,
        "supplier_transactions": [
          { "type": "invoice", "amount": 100 }
        ],
        "cash_movement": null
      }
    },
    {
      "name": "cash purchase clears supplier subledger and credits cash",
      "payment_method": "cash",
      "total_amount": 100,
      "expected": {
        "settlement_account": "cash",
        "supplier_balance_delta": 0,
        "supplier_transactions": [
          { "type": "invoice", "amount": 100 },
          { "type": "payment", "amount": -100 }
        ],
        "cash_movement": {
          "type": "disbursement",
          "amount": 100
        }
      }
    }
  ]
}
