{
  "lifecycle": [
    {
      "name": "completed credit is valid",
      "status": "completed",
      "payment_method": "credit",
      "check_number": null,
      "expected_ok": true
    },
    {
      "name": "draft check may omit check number",
      "status": "draft",
      "payment_method": "check",
      "check_number": null,
      "expected_ok": true
    },
    {
      "name": "completed check requires check number",
      "status": "completed",
      "payment_method": "check",
      "check_number": "   ",
      "expected_ok": false
    },
    {
      "name": "unknown status is invalid",
      "status": "processing",
      "payment_method": "credit",
      "check_number": null,
      "expected_ok": false
    },
    {
      "name": "unknown payment method is invalid",
      "status": "completed",
      "payment_method": "wallet",
      "check_number": null,
      "expected_ok": false
    }
  ],
  "dates": [
    {
      "name": "iso date remains stable",
      "input": "2028-01-31",
      "expected": "2028-01-31"
    },
    {
      "name": "day first date normalizes",
      "input": "31/01/2028",
      "expected": "2028-01-31"
    },
    {
      "name": "year first slash date normalizes",
      "input": "2028/01/31",
      "expected": "2028-01-31"
    },
    {
      "name": "legacy month year date normalizes to first day",
      "input": "01/2028",
      "expected": "2028-01-01"
    },
    {
      "name": "invalid calendar date is rejected",
      "input": "2028-02-30",
      "expected": null
    },
    {
      "name": "blank date is absent",
      "input": "   ",
      "expected": null
    }
  ],
  "expiry": [
    {
      "name": "missing completed expiry is invalid",
      "today": "2026-09-28",
      "expiry_date": null,
      "expected_ok": false
    },
    {
      "name": "expired completed expiry is invalid",
      "today": "2026-09-28",
      "expiry_date": "2026-09-27",
      "expected_ok": false
    },
    {
      "name": "today completed expiry is valid",
      "today": "2026-09-28",
      "expiry_date": "2026-09-28",
      "expected_ok": true
    },
    {
      "name": "future completed expiry is valid",
      "today": "2026-09-28",
      "expiry_date": "31/01/2028",
      "expected_ok": true
    }
  ],
